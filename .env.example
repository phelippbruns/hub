# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# .env.local está no .gitignore: nenhum valor real entra no repositório.

# --- Servidor (segredos: nunca com prefixo NEXT_PUBLIC_) ---

# Conexão usada pelo Prisma em runtime. No Supabase é o pooler, porta 6543.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Porta 5432, usada por `prisma migrate`: o pooler de transação (6543) não
# aceita migrations.
#
# Use o POOLER DE SESSÃO, não a conexão direta `db.PROJETO.supabase.co`. A
# direta só responde em IPv6, e ambientes de build como a Vercel são IPv4 —
# de lá ela falha com "P1001: Can't reach database server".
DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Chave secreta do Supabase: em Project Settings > API Keys, a que começa
# com sb_secret_. Ignora o Row Level Security, então nunca sai do servidor.
SUPABASE_SECRET_KEY=""

# --- Navegador (públicas por definição) ---

# Em Project Settings > API Keys: a URL do projeto e a chave sb_publishable_.
NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Verificação de idade (RN29) ---

# Ausente significa NEGAR todo cadastro, que é o lado seguro enquanto não há
# provedor real escolhido (pendência jurídica, ver docs/escopo.md).
# "self_declared" aceita a data que a pessoa informa. NÃO cumpre a RN29, que
# exige verificação sem autodeclaração. Está ligado por decisão do PO, para
# permitir cadastros de teste, e precisa sair antes do lançamento.
AGE_VERIFIER=""
