# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# .env.local está no .gitignore: nenhum valor real entra no repositório.

# --- Servidor (segredos: nunca com prefixo NEXT_PUBLIC_) ---

# Conexão usada pelo Prisma em runtime. No Supabase é o pooler, porta 6543.
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta, porta 5432. Usada por `prisma migrate` e introspecção,
# que não funcionam através do pooler.
DIRECT_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Chave que ignora Row Level Security. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Navegador (públicas por definição) ---

NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
